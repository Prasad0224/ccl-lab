# =============================================================================
# Fundora Auto DD Engine — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your API key(s).
#
# MINIMUM REQUIRED: At least one LLM key for the full AI pipeline.
# The engine auto-detects which providers are available and routes
# traffic optimally (Gemini → extraction, OpenAI → scoring/narrative).
# =============================================================================

# ── LLM API Keys ──────────────────────────────────────────────────────────────
# Provide BOTH for optimal dual-provider routing.
# Provide at least ONE to run the full AI pipeline.
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# ── Server (optional overrides) ────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8001
# DEBUG=false

# ── Upload Limits (optional overrides) ────────────────────────────────────────
# MAX_FILE_SIZE_MB=50
# MAX_TOTAL_UPLOAD_MB=200

# ── CORS / Frontend URL ────────────────────────────────────────────────────────
# Set FRONTEND_URL to restrict CORS to your deployed frontend origin.
# In local dev, this defaults to http://localhost:3000 if not set.
FRONTEND_URL=http://localhost:3000

# ── Report Persistence ─────────────────────────────────────────────────────────
# Pass a startup_id (e.g. S-001, INV001) to tag the persisted report file.
# Report saved as: data/reports/RPT-{startup_id}.json
# STARTUP_ID=S-001
